# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored by default in most Streamlit setups -- never commit real keys.

[bigquery]
project_id = "your-gcp-project-id"
dataset = "analytics"  # matches the dbt `dataset:` target -- see saul_stitch_house_analytics/profiles.example.yml

# Paste the full contents of a BigQuery service account JSON key here.
# Grant it "BigQuery Data Viewer" + "BigQuery Job User" on the project (read-only is enough).
[bigquery.service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Optional -- enables the AI Insights narrative button and the Talk to Your Data chatbot.
[anthropic]
api_key = "sk-ant-..."
model = "claude-sonnet-4-5"  # optional, this is the default
